{
    "layer" : "top",
   // "layer": "overlay",
    "position": "top",
 //   "exclusive":false,
 
   //"passthrough": true,
    "width": 1900,
    "height": 25,
    "margin": "5 0",

    "group/left" : {
        "orientation": "horizontal",
        "modules" : [
          "hyprland/workspaces" 
//            "niri/workspaces",
//            "mpris"
        ]
    },

    "group/left-hidden" : {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules" : [
            "custom/arrow-right", "battery", "cpu","temperature"
        ]
    },

    "group/left-hidden-top" : {
        "orientation": "horizontal",
        "modules" : [ "cpu","load","memory"]
    },

    "group/right" : {
        "orientation": "horizontal",
        "modules" : [
             "group/group-volume", "group/group-backlight", "network", "tray" , "battery"       ]
    },

    "group/right-top" :{
      "orientation": "horizontal",
      "modules": [
        "power-profiles-daemon"
      ]
    },

    "group/right-hidden-top" : {
        "orientation": "horizontal",
        "modules" : [ "group/right-hidden",  "custom/ctlcenter" ]
    },

    "modules-left"   : ["group/left-hidden-top", "group/left"],
    "modules-center" : ["clock"],
    "modules-right"  : [ "group/right","group/right-top"],

    "include": [ "~/.config/waybar/modules.jsonc" ]
    
}
